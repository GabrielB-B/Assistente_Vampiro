{
  "name": "@assistente-vampiro/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx --env-file-if-exists=../.env src/cli/migrate.ts up",
    "db:rollback": "tsx --env-file-if-exists=../.env src/cli/migrate.ts down",
    "db:status": "tsx --env-file-if-exists=../.env src/cli/migrate.ts status",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "kysely": "0.29.6",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "eslint": "catalog:",
    "eslint-config-prettier": "10.1.8",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.1",
    "vitest": "catalog:"
  }
}
